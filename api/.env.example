# Port the Bun API server listens on.
PORT=3000

# Postgres connection string used by the API and Drizzle.
DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require

# Upstash Redis REST endpoint used for deployment job dispatch.
UPSTASH_REDIS_REST_URL=https://your-upstash-instance.upstash.io

# Upstash Redis REST token used to authenticate queue writes.
UPSTASH_REDIS_REST_TOKEN=your-upstash-redis-rest-token

# Queue name for deployment jobs; defaults to deployment_jobs when omitted.
DEPLOYMENT_QUEUE_NAME=deployment_jobs

# Base URL used to generate deployment preview URLs.
DEPLOYMENT_PREVIEW_BASE_URL=https://preview.example.com

# Required server-to-server Bearer token; protected routes fail closed if unset.
API_AUTH_TOKEN=your-shared-api-token

# Secret used to encrypt and decrypt project environment variables at rest.
PROJECT_ENV_ENCRYPTION_KEY=replace-with-a-long-random-secret

# Worker wake endpoint invoked after a job is enqueued (scale-to-zero workers).
WORKER_WAKE_URL=http://localhost:8080/internal/process

# Shared secret sent as Bearer token when waking the worker.
WORKER_WAKE_SECRET=replace-with-a-long-random-secret

# Cloudflare site-serving domain (dedicated origin, private R2 bucket).
SITES_DOMAIN=sites.example.com
ROUTING_SECRET=replace-with-a-separate-long-random-secret
MAX_BUILDS_PER_DAY=20
MAX_TOTAL_BUILDS_PER_DAY=100
# GitHub App + dashboard. See docs/STATIC_PLATFORM.md.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=
WEB_BASE_URL=https://your-dashboard.example.com
GITHUB_RUNNER_REPOSITORY=
GITHUB_RUNNER_INSTALLATION_ID=
GITHUB_RUNNER_REF=main
